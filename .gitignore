# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Local git worktrees used for isolated feature development.
# Historical recovery points; preserved on the operator's machine but
# never committed.
.worktrees/

# Local reference papers (copyrighted journal PDFs, do not redistribute)
ref/

# Generated benchmark output. The benchmark CSVs are NOT committed; they
# are regenerated from `benchmarks/run_benchmark.py` and described in
# `data/manifest.tsv`. Tracked source-data tables (when added) live under
# `data/` with explicit manifest rows.
data/bench_*.csv
data/*_local.csv
data/calibration_smoke_v2.csv
data/calibration_smoke_summary_v2.json
data/calibration_holdout_v2.csv
data/calibration_summary_v2.json

# Public-data downloads. Raw third-party archives are never committed
# (see `data/public/*.md`). Only the pointer markdown files belong in the
# tree.
data/public/**/*
!data/public/*.md
